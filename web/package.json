{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && eslint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "gen:api-types": "openapi-typescript ../spec/openapi.yaml -o lib/api-types.ts",
    "gen:api-schemas": "openapi-ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/nextjs-vite": "^10.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.62.1",
    "playwright-bdd": "^9.2.0",
    "storybook": "^10.5.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "^4.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
